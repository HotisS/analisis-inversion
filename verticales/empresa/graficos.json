{
  "segmentos": {
    "tipo": "donut", "titulo": "Ingresos por segmento (% del total)",
    "datos": "negocio.segmentos", "categoria": "nombre",
    "series": [{ "campo": "peso_pct", "nombre": "% de ingresos" }],
    "alto_cm": 6.5
  },
  "geografias": {
    "tipo": "barras", "titulo": "Ingresos por geografía (% del total)",
    "datos": "negocio.geografias", "categoria": "nombre",
    "series": [{ "campo": "peso_pct", "nombre": "% de ingresos" }],
    "formato": "0\"%\"", "etiquetas": true, "alto_cm": 6
  },
  "ingresos_ebitda": {
    "tipo": "columnas", "titulo": "Ingresos y EBITDA ({{meta.divisa}}, {{meta.unidades}})",
    "datos": "financieros.historico", "categoria": "periodo",
    "series": [{ "campo": "ingresos", "nombre": "Ingresos" }, { "campo": "ebitda", "nombre": "EBITDA" }],
    "formato": "#,##0"
  },
  "margenes": {
    "tipo": "lineas", "titulo": "Márgenes (% de ingresos)",
    "datos": "financieros.historico", "categoria": "periodo",
    "series": [
      { "campo": "margen_bruto_pct", "nombre": "Margen bruto" },
      { "campo": "margen_ebitda_pct", "nombre": "Margen EBITDA" },
      { "campo": "margen_neto_pct", "nombre": "Margen neto" }
    ],
    "formato": "0\"%\""
  },
  "fcf": {
    "tipo": "columnas", "titulo": "Flujo de caja libre frente a beneficio neto ({{meta.divisa}}, {{meta.unidades}})",
    "datos": "caja.historico", "categoria": "periodo",
    "series": [{ "campo": "fcf", "nombre": "Flujo de caja libre" }, { "campo": "beneficio_neto", "nombre": "Beneficio neto" }],
    "formato": "#,##0"
  },
  "roic": {
    "tipo": "lineas", "titulo": "ROIC frente a coste del capital (%)",
    "datos": "rentabilidad.historico", "categoria": "periodo",
    "series": [{ "campo": "roic_pct", "nombre": "ROIC" }, { "campo": "wacc_pct", "nombre": "WACC" }, { "campo": "roe_pct", "nombre": "ROE" }],
    "formato": "0\"%\""
  },
  "apalancamiento": {
    "tipo": "columnas", "titulo": "Deuda neta / EBITDA (veces)",
    "datos": "balance.historico", "categoria": "periodo",
    "series": [{ "campo": "dn_ebitda", "nombre": "Deuda neta / EBITDA" }],
    "formato": "0.0\"x\"", "etiquetas": true, "alto_cm": 6
  },
  "vencimientos": {
    "tipo": "columnas", "titulo": "Calendario de vencimientos de deuda ({{meta.divisa}}, {{meta.unidades}})",
    "datos": "balance.vencimientos", "categoria": "anio",
    "series": [{ "campo": "importe", "nombre": "Vencimientos" }],
    "formato": "#,##0", "etiquetas": true, "alto_cm": 6
  },
  "usos_caja": {
    "tipo": "columnas_apiladas", "titulo": "Usos de la caja ({{meta.divisa}}, {{meta.unidades}})",
    "datos": "capital.historico", "categoria": "periodo",
    "series": [
      { "campo": "dividendos", "nombre": "Dividendos" },
      { "campo": "recompras", "nombre": "Recompras" },
      { "campo": "adquisiciones", "nombre": "Adquisiciones" }
    ],
    "formato": "#,##0"
  },
  "multiplos": {
    "tipo": "columnas", "titulo": "Múltiplos: hoy, su media de 5 años y comparables",
    "datos": "multiplos.tabla", "categoria": "metrica",
    "series": [
      { "campo": "actual", "nombre": "Actual" },
      { "campo": "media_5a", "nombre": "Media 5 años" },
      { "campo": "comparables", "nombre": "Comparables" }
    ],
    "formato": "0.0\"x\""
  },
  "comparables_ev": {
    "tipo": "barras", "titulo": "EV/EBITDA de los comparables (veces)",
    "datos": "comparables.empresas", "categoria": "nombre",
    "series": [{ "campo": "ev_ebitda", "nombre": "EV/EBITDA" }],
    "formato": "0.0\"x\"", "etiquetas": true, "resaltar": 0, "alto_cm": 7
  },
  "comparables_mapa": {
    "tipo": "dispersion", "titulo": "Crecimiento frente a múltiplo",
    "datos": "comparables.empresas", "etiqueta": "nombre",
    "x": { "campo": "crecimiento_pct", "nombre": "Crecimiento de ingresos (%)", "formato": "0\"%\"" },
    "y": { "campo": "ev_ebitda", "nombre": "EV/EBITDA (x)", "formato": "0.0\"x\"" },
    "alto_cm": 8
  },
  "escenarios": {
    "tipo": "columnas", "titulo": "Valor por acción por escenario ({{meta.divisa}}) · precio actual {{escenarios.precio_actual|2}}",
    "datos": "escenarios.casos", "categoria": "escenario",
    "series": [{ "campo": "valor", "nombre": "Valor por acción" }],
    "formato": "#,##0.00", "etiquetas": true, "alto_cm": 6
  },
  "bolsa": {
    "tipo": "columnas", "titulo": "Rentabilidad total: acción frente a su índice (%)",
    "datos": "bolsa.rentabilidades", "categoria": "periodo",
    "series": [{ "campo": "accion_pct", "nombre": "Acción" }, { "campo": "indice_pct", "nombre": "Índice de referencia" }],
    "formato": "0\"%\"", "etiquetas": true, "alto_cm": 6.5
  }
}
